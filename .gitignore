# La repo contiene la mod (sorgenti, file Gradle), gli strumenti (tools/) e la ricerca (ricerca/).
# Resta in locale: PASSAGGIO, design, libs, run, build.
/*
!/.gitignore
!/README.md
!/LICENSE
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/.forgejo/
!/.github/
!/CHANGELOG.md
!/src/
!/docs/
!/tools/
!/ricerca/

# Generati da Gradle o dall'IDE
.gradle/
build/
.idea/
*.iml
out/
__pycache__/

# Script locale dell'autore (mondo di test), fuori dalla repo per scelta
tools/reset_test_world.py
# Risultati dei test ciechi sulle texture (output generato)
tools/test_cieco/
