// Progressione del T7 (Umbral) da un giocatore "vergine". Catena VERA (JSON generati da tools/gen_data.py):
//   spectral_ascension:unlocks/tiers/umbral   = advancement_gotten(unlocks/tiers/trichromatic) E inventory_changed(#c:ingots/vibranium)
//   unlocks/equipment/t7/umbral_<oggetto> = advancement_gotten(t7) E advancement_gotten(unlocks/equipment/t6/trichromatic_<oggetto>)
//   voce T7 (equipment, figlia della voce T6) = condizione unlocks/tiers/umbral, nascosta da bloccata
//   (l'Idea esiste solo per il T6: niente Idea T7 dal 2026-11-23)
// Controlla anche l'ordine: il vibranium preso PRIMA del T6 non apre niente finché il T6 non c'è.
// Le NOSTRE advancement non si concedono mai a mano: devono scattare da sole.
{
  "description": "Catena di sblocco del T7: tier dopo il T6, pezzi dopo il pezzo T6, voce del guidebook",
  "steps": [
    // ---------------------------------------------------------------- 0. giocatore vergine
    {"action": "command", "expect": "any", "commands": [
      "gamemode creative", "clear @s", "time set 6000", "weather clear", "tp @s 0.5 -60 -6.5 180 0",
      "advancement revoke @s everything"
    ]},
    {"action": "reset_book", "book": "spectrum:guidebook"},
    {"action": "wait", "ticks": 10},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/umbral", "done": false},
    {"action": "assert_book_entry", "entry": "spectrum:equipment/spectral_ascension_t7_equipment", "unlocked": false},

    // ---------------------------------------------------------------- 1. vibranium prima del T6: niente
    {"action": "command", "command": "give @s allthemodium:vibranium_ingot"},
    {"action": "wait", "ticks": 10},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/umbral", "done": false},
    {"action": "assert_recipe_unlocked", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_sword", "unlocked": false},

    // ---------------------------------------------------------------- 2. T6 (Pedestal Moonstone + allthemodium)
    {"action": "command", "commands": [
      "advancement grant @s until spectrum:place_pedestal",
      "advancement grant @s until spectrum:build_fusion_shrine",
      "advancement grant @s until spectrum:lategame/build_complex_pedestal_structure",
      "advancement grant @s until spectrum:milestones/unlock_ink_use",
      "advancement grant @s only spectrum:unlocks/equipment/bedrock_tools",
      // dal 2026-11-18 l'armatura T6 si fa con gli accessori Dike: senza questi sblocchi i pezzi T6 (e quindi
      // T7/T8) dell'armatura restano bloccati
      "advancement grant @s until spectrum:unlocks/trinkets/puff_circlet",
      "advancement grant @s until spectrum:unlocks/trinkets/azure_dike_ring",
      "advancement grant @s until spectrum:unlocks/trinkets/azure_dike_belt",
      "advancement grant @s until spectrum:unlocks/trinkets/shieldgrasp_amulet",
      "advancement grant @s until spectrum:unlocks/trinkets/azuresque_dike_core"
    ]},
    {"action": "command", "command": "give @s allthemodium:allthemodium_ingot"},
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/trichromatic"},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t6/trichromatic_sword"},
    // Il T7 scatta da solo: il criterio del vibranium era già registrato, quello del T6 arriva ora (gotten o tick).
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/umbral"},
    // Si torna a «T6 sì, T7 no»: si revocano il T7 e tutto quello che ha aperto (i pezzi T7).
    {"action": "command", "expect": "any", "commands": [
      "advancement revoke @s only spectral_ascension:unlocks/tiers/umbral",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_workstaff",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_ultra_greatsword",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_crossbow",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_bident",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_axe",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_shovel",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_hoe",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_sword",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_bow",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_fishing_rod",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_shears",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_helmet",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_chestplate",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_leggings",
      "advancement revoke @s only spectral_ascension:unlocks/equipment/t7/umbral_boots"
    ]},
    {"action": "command", "expect": "any", "command": "clear @s"},
    // Modonomicon non richiude da sola una voce già aperta quando l'advancement viene revocato: si azzera il libro.
    {"action": "reset_book", "book": "spectrum:guidebook"},
    {"action": "wait", "ticks": 5},
    // Per guardare la voce nello stato «T6 sì, T7 no» si toglie il vibranium e si revoca il T7.
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/umbral", "done": false},
    {"action": "wait", "ticks": 40},
    {"action": "assert_book_entry", "entry": "spectrum:equipment/spectral_ascension_t7_equipment", "unlocked": false},
    {"action": "book_focus", "entry": "spectrum:equipment/spectral_ascension_t6_equipment"},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "libro_equipment_t6_senza_t7"},
    {"action": "close_screen"},

    // ---------------------------------------------------------------- 3. primo lingotto di vibranium → T7
    {"action": "command", "command": "give @s allthemodium:vibranium_ingot"},
    {"action": "wait", "ticks": 10},
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/tiers/umbral"},
    // I pezzi T6 sbloccati (bedrock tools) aprono i T7 corrispondenti; quelli che chiedono glass crest o accessori no.
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_sword"},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_axe"},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_boots"},
    {"action": "assert_recipe_unlocked", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_sword", "unlocked": true},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_workstaff", "done": false},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_bident", "done": false},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_helmet"},
    {"action": "assert_recipe_unlocked", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_workstaff", "unlocked": false},
    {"action": "wait", "ticks": 40},
    {"action": "assert_book_entry", "entry": "spectrum:equipment/spectral_ascension_t7_equipment", "unlocked": true},
    {"action": "assert_book_entry", "entry": "spectrum:equipment/spectral_ascension_t7_equipment", "page": 0, "unlocked": true},
    {"action": "book_focus", "entry": "spectrum:equipment/spectral_ascension_t7_equipment"},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "libro_equipment_t7_tooltip"},
    {"action": "open_screen", "screen": "guidebook", "entry": "spectrum:equipment/spectral_ascension_t7_equipment", "page": 0},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "voce_t7_pagina0"},
    {"action": "close_screen"},

    // ---------------------------------------------------------------- 4. workstaff glass crest → T6 → T7
    {"action": "command", "command": "advancement grant @s until spectrum:unlocks/malachite/glass_crest_workstaff"},
    {"action": "wait", "ticks": 10},
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t6/trichromatic_workstaff"},
    {"action": "wait", "ticks": 20},
    {"action": "assert_advancement", "id": "spectral_ascension:unlocks/equipment/t7/umbral_workstaff"},
    {"action": "open_screen", "screen": "recipes", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_workstaff"},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "emi_workstaff_t7"},
    {"action": "close_screen"},
    {"action": "open_screen", "screen": "recipes", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_chestplate"},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "emi_corazza_t7_bloccata"},
    {"action": "close_screen"},
    {"action": "open_screen", "screen": "recipes", "recipe": "spectral_ascension:fusion_shrine/t7/umbral_sword"},
    {"action": "wait", "ticks": 5},
    {"action": "screenshot", "name": "emi_spada_t7"},
    {"action": "close_screen"},
    {"action": "command", "expect": "any", "commands": ["clear @s", "advancement revoke @s everything"]}
  ]
}
